<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020B38">

    <!-- Header: logo + title centered -->
    <ImageView
        android:id="@+id/headerLogo"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/logo"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profile Settings"
        android:textColor="#cbcafe"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/headerLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Avatar + name -->
    <ImageView
        android:id="@+id/profileAvatar"
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:src="@drawable/profile"
        android:contentDescription="@string/app_name"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/headerTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/profileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User's Name"
        android:textColor="#E6E6E6"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/profileAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Container for actions -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/actionsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#1AFFFFFF"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/profileName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="24dp">

        <!-- Change Settings -->
        <Button
            android:id="@+id/btnChangeSettings"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Change Settings"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#0A0A0A"
            android:backgroundTint="#cbcafe"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Change Password -->
        <Button
            android:id="@+id/btnChangePassword"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Change Password"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#0A0A0A"
            android:backgroundTint="#cbcafe"
            app:layout_constraintTop_toBottomOf="@id/btnChangeSettings"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"/>

        <!-- View Lease Info -->
        <Button
            android:id="@+id/btnViewLeaseInfo"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="View Lease Info"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#0A0A0A"
            android:backgroundTint="#cbcafe"
            app:layout_constraintTop_toBottomOf="@id/btnChangePassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"/>

        <!-- Change Payment Method -->
        <Button
            android:id="@+id/btnChangePaymentMethod"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Change Payment Method"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#0A0A0A"
            android:backgroundTint="#cbcafe"
            app:layout_constraintTop_toBottomOf="@id/btnViewLeaseInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Logout (separate, sticky near bottom) -->
    <Button
        android:id="@+id/button13"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:text="Logout"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#A98F3C"
        app:layout_constraintStart_toStartOf="@id/actionsContainer"
        app:layout_constraintEnd_toEndOf="@id/actionsContainer"
        app:layout_constraintTop_toBottomOf="@id/actionsContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
