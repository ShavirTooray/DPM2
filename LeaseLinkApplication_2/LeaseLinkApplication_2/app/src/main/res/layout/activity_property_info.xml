<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020B38">

    <!-- Title -->
    <TextView
        android:id="@+id/textView36"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Lakewood Property"
        android:textColor="#cbcafe"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="24dp" />

    <!-- Hero image -->
    <ImageView
        android:id="@+id/imageView12"
        android:layout_width="0dp"
        android:layout_height="254dp"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:src="@drawable/istockphoto_109350275_612x612"
        app:layout_constraintTop_toBottomOf="@id/textView36"
        app:layout_constraintStart_toStartOf="@id/textView36"
        app:layout_constraintEnd_toEndOf="@id/textView36"
        android:layout_marginTop="12dp" />

    <!-- Location -->
    <TextView
        android:id="@+id/textView40"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Location: 12 Palm Street, Cape Town, 8001"
        android:textColor="#cbcafe"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/imageView12"
        app:layout_constraintStart_toStartOf="@id/textView36"
        app:layout_constraintEnd_toEndOf="@id/textView36"
        android:layout_marginTop="16dp" />

    <!-- Price -->
    <TextView
        android:id="@+id/textView43"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Price: R5,500 / month"
        android:textColor="#cbcafe"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/textView40"
        app:layout_constraintStart_toStartOf="@id/textView36"
        app:layout_constraintEnd_toEndOf="@id/textView36"
        android:layout_marginTop="8dp" />

    <!-- Beds/Baths -->
    <TextView
        android:id="@+id/textView44"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Bedrooms: 3    Bathrooms: 2"
        android:textColor="#cbcafe"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/textView43"
        app:layout_constraintStart_toStartOf="@id/textView36"
        app:layout_constraintEnd_toEndOf="@id/textView36"
        android:layout_marginTop="8dp" />

    <!-- Description -->
    <TextView
        android:id="@+id/textView45"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Description: Beautiful modern villa with a spacious living area, perfect for families. Close to schools and shopping centers."
        android:textColor="#cbcafe"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/textView44"
        app:layout_constraintStart_toStartOf="@id/textView36"
        app:layout_constraintEnd_toEndOf="@id/textView36"
        android:layout_marginTop="12dp" />

    <!-- Apply button -->
    <Button
        android:id="@+id/button7"
        android:layout_width="0dp"
        android:layout_height="51dp"
        android:text="APPLY NOW"
        android:textSize="20sp"
        android:backgroundTint="#A98F3C"
        app:layout_constraintStart_toStartOf="@id/textView36"
        app:layout_constraintEnd_toEndOf="@id/textView36"
        app:layout_constraintTop_toBottomOf="@id/textView45"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
