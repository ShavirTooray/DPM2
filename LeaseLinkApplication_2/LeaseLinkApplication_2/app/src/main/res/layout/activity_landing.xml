<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020B38">

    <!-- Tagline -->
    <TextView
        android:id="@+id/rentStatusLabel2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Find your dream house with Lease Link today."
        android:textColor="#EDE5E5"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"/>

    <!-- Hero image -->
    <ImageView
        android:id="@+id/imageView14"
        android:layout_width="0dp"
        android:layout_height="179dp"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:src="@drawable/istockphoto_109350275_612x612"
        app:layout_constraintTop_toBottomOf="@id/rentStatusLabel2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"/>

    <!-- Browse button (top-right of hero) -->
    <Button
        android:id="@+id/button8"
        android:layout_width="113dp"
        android:layout_height="41dp"
        android:text="BROWSE"
        android:backgroundTint="#A98F3C"
        app:layout_constraintTop_toTopOf="@id/imageView14"
        app:layout_constraintEnd_toEndOf="@id/imageView14"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"/>

    <!-- ===== Property grid: 2 x 2 ===== -->

    <!-- Card 1 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#52CBCAFE"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/imageView14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/card2"
        app:layout_constraintDimensionRatio="176:258"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="16dp">

        <ImageButton
            android:id="@+id/imageButton7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@null"
            android:scaleType="fitXY"
            android:src="@drawable/images"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/textView34"/>

        <TextView
            android:id="@+id/textView34"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Property 1"
            android:textColor="#cbcafe"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card 2 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#52CBCAFE"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="@id/card1"
        app:layout_constraintStart_toEndOf="@id/card1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="180:259"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp">

        <ImageButton
            android:id="@+id/imageButton8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@null"
            android:scaleType="fitXY"
            android:src="@drawable/_60x470xc"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/textView35"/>

        <TextView
            android:id="@+id/textView35"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Property 2"
            android:textColor="#cbcafe"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card 3 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#52CBCAFE"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/card1"
        app:layout_constraintStart_toStartOf="@id/card1"
        app:layout_constraintEnd_toStartOf="@id/card4"
        app:layout_constraintDimensionRatio="176:253"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp">

        <ImageButton
            android:id="@+id/imageButton9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@null"
            android:scaleType="fitXY"
            android:src="@drawable/_60x470xc__1_"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/textView41"/>

        <TextView
            android:id="@+id/textView41"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Property 3"
            android:textColor="#cbcafe"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card 4 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#52CBCAFE"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="@id/card3"
        app:layout_constraintStart_toEndOf="@id/card3"
        app:layout_constraintEnd_toEndOf="@id/card2"
        app:layout_constraintBottom_toBottomOf="@id/card3"
        app:layout_constraintDimensionRatio="181:253"
        android:layout_marginStart="8dp">

        <ImageButton
            android:id="@+id/imageButton10"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@null"
            android:scaleType="fitXY"
            android:src="@drawable/__bedroom_apartment_for_sale_ewan_residence_1_lp46040_200f39ee9fdb2600"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/textView42"/>

        <TextView
            android:id="@+id/textView42"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Property 4"
            android:textColor="#cbcafe"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sign up button -->
    <Button
        android:id="@+id/button6"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Sign up"
        android:textSize="20sp"
        android:backgroundTint="#A98F3C"
        app:layout_constraintStart_toStartOf="@id/card1"
        app:layout_constraintEnd_toEndOf="@id/card2"
        app:layout_constraintTop_toBottomOf="@id/card3"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>



