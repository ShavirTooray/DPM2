<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020B38">

    <!-- Logo -->
    <ImageView
        android:id="@+id/imageView11"
        android:layout_width="197dp"
        android:layout_height="152dp"
        android:src="@drawable/logo"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/textView33"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/abeezee"
        android:text="Your application has been received"
        android:textAlignment="center"
        android:textColor="#cbcafe"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/imageView11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp" />

    <!-- Full Name label -->
    <TextView
        android:id="@+id/textView37"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Full Name"
        android:textColor="#cbcafe"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@id/textView33"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp" />

    <!-- Full Name value -->
    <TextView
        android:id="@+id/tvApplyNow2"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:gravity="center"
        android:text="Full Name"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#FFEB3B"
        android:backgroundTint="#69FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/textView37"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp" />

    <!-- Property label -->
    <TextView
        android:id="@+id/textView38"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Property Details"
        android:textColor="#cbcafe"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@id/tvApplyNow2"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp" />

    <!-- Property value -->
    <TextView
        android:id="@+id/tvApplyNow3"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:gravity="center"
        android:text="Property"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#FFEB3B"
        android:backgroundTint="#69FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/textView38"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp" />

    <!-- Submission Date label -->
    <TextView
        android:id="@+id/textView39"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Application Submission Date"
        android:textColor="#cbcafe"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@id/tvApplyNow3"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp" />

    <!-- Submission Date value -->
    <TextView
        android:id="@+id/tvApplyNow4"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:gravity="center"
        android:text="Submission Date"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#FFEB3B"
        android:backgroundTint="#69FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/textView39"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp" />

    <!-- Complete button -->
    <Button
        android:id="@+id/button5"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:text="COMPLETE"
        android:textSize="24sp"
        android:backgroundTint="#A98F3C"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

