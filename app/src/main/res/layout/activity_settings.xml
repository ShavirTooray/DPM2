<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020B38"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imageView7"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="16dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/textView26"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/abeezee"
            android:text="Profile Settings"
            android:textColor="#cbcafe"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/imageView7"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/imageView7"
            app:layout_constraintBottom_toBottomOf="@id/imageView7"
            android:layout_marginStart="12dp" />

        <!-- Profile block -->
        <ImageView
            android:id="@+id/imageView8"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageView7"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/textView27"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="User's Name"
            android:textColor="#B1B1B1"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/imageView8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/imageView8"
            app:layout_constraintBottom_toBottomOf="@id/imageView8"
            android:layout_marginStart="16dp" />

        <!-- Divider A -->
        <View
            android:id="@+id/dividerA"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#cbcafe"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageView8"
            android:layout_marginTop="20dp" />

        <!-- Row: Change Settings -->
        <TextView
            android:id="@+id/textView28"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Change Settings"
            android:textColor="#B1B1B1"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerA"
            android:layout_marginTop="16dp" />

        <!-- Divider B -->
        <View
            android:id="@+id/dividerB"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#cbcafe"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView28"
            android:layout_marginTop="12dp" />

        <!-- Row: Change Password -->
        <TextView
            android:id="@+id/textView29"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Change Password"
            android:textColor="#B1B1B1"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerB"
            android:layout_marginTop="16dp" />

        <!-- Divider C -->
        <View
            android:id="@+id/dividerC"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#cbcafe"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView29"
            android:layout_marginTop="12dp" />

        <!-- Row: View Lease Info -->
        <TextView
            android:id="@+id/textView32"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="View Lease Info"
            android:textColor="#B1B1B1"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerC"
            android:layout_marginTop="16dp" />

        <!-- Divider D -->
        <View
            android:id="@+id/dividerD"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#cbcafe"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView32"
            android:layout_marginTop="12dp" />

        <!-- Row: Change Payment Method -->
        <TextView
            android:id="@+id/textView30"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Change Payment Method"
            android:textColor="#B1B1B1"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerD"
            android:layout_marginTop="16dp" />

        <!-- Divider E -->
        <View
            android:id="@+id/dividerE"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#cbcafe"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView30"
            android:layout_marginTop="12dp" />

        <!-- Logout Button -->
        <Button
            android:id="@+id/button13"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:backgroundTint="#A98F3C"
            android:text="Logout"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerE"
            android:layout_marginTop="20dp"
            android:layout_marginStart="58dp"
            android:layout_marginEnd="58dp" />

        <!-- Bottom spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="12dp"
            app:layout_constraintTop_toBottomOf="@id/button13"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

