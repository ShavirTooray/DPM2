<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#020B38">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/textView36"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Lakewood Property"
            android:textColor="#cbcafe"
            android:textSize="24sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <ImageView
            android:id="@+id/imageView12"
            android:layout_width="0dp"
            android:layout_height="254dp"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:src="@drawable/istockphoto_109350275_612x612"
            app:layout_constraintTop_toBottomOf="@id/textView36"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/textView40"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Location: 12 Palm Street, Cape Town, 8001"
            android:textColor="#cbcafe"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@id/imageView12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/textView43"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Price: R5,500 / month"
            android:textColor="#cbcafe"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@id/textView40"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/textView44"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Bedrooms: 3  Bathrooms: 2"
            android:textColor="#cbcafe"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@id/textView43"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/textView45"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Description: Beautiful modern villa with a spacious living area, perfect for families. Close to schools and shopping centers."
            android:textColor="#cbcafe"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@id/textView44"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/button7"
            android:layout_width="0dp"
            android:layout_height="51dp"
            android:backgroundTint="#A98F3C"
            android:text="APPLY NOW"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@id/textView45"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <!-- Spacer to ensure button isn’t clipped on small screens -->
        <View
            android:layout_width="0dp"
            android:layout_height="12dp"
            app:layout_constraintTop_toBottomOf="@id/button7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
