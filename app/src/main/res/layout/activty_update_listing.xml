<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020B38"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <ImageView
            android:id="@+id/imageView17"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/logo"
            android:contentDescription="@string/app_name"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/textView49"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/abeezee"
            android:text="Update Listings"
            android:textColor="#cbcafe"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/imageView17"
            app:layout_constraintBottom_toBottomOf="@id/imageView17"
            app:layout_constraintStart_toEndOf="@id/imageView17"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="12dp" />

        <!-- Grid of 2 x 2 listing cards -->

        <!-- Card 1 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardProperty1"
            android:layout_width="0dp"
            android:layout_height="258dp"
            android:background="#52CBCAFE"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/imageView17"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cardProperty2"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:id="@+id/imageButton1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@null"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                android:padding="0dp"
                app:srcCompat="@drawable/_60x470xc"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/title1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/title1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Property 1"
                android:textColor="#cbcafe"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Card 2 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardProperty2"
            android:layout_width="0dp"
            android:layout_height="259dp"
            android:background="#52CBCAFE"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/imageView17"
            app:layout_constraintStart_toEndOf="@id/cardProperty1"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:layout_marginStart="8dp">

            <ImageButton
                android:id="@+id/imageButton2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@null"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                android:padding="0dp"
                app:srcCompat="@drawable/__bedroom_apartment_for_sale_ewan_residence_1_lp46040_200f39ee9fdb2600"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/title2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/title2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Property 2"
                android:textColor="#cbcafe"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Card 3 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardProperty3"
            android:layout_width="0dp"
            android:layout_height="258dp"
            android:background="#52CBCAFE"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardProperty1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cardProperty4"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:id="@+id/imageButton3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@null"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                android:padding="0dp"
                app:srcCompat="@drawable/_60x470xc"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/title3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/title3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Property 3"
                android:textColor="#cbcafe"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Card 4 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardProperty4"
            android:layout_width="0dp"
            android:layout_height="258dp"
            android:background="#52CBCAFE"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardProperty2"
            app:layout_constraintStart_toEndOf="@id/cardProperty3"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp">

            <ImageButton
                android:id="@+id/imageButton4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@null"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                android:padding="0dp"
                app:srcCompat="@drawable/_60x470xc"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/title4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/title4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Property 4"
                android:textColor="#cbcafe"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Action buttons -->
        <Button
            android:id="@+id/button18"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Add New Listing"
            android:textSize="18sp"
            android:backgroundTint="#A98F3C"
            app:layout_constraintTop_toBottomOf="@id/cardProperty3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp" />

        <Button
            android:id="@+id/button20"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Update Listing"
            android:textSize="18sp"
            android:backgroundTint="#A98F3C"
            app:layout_constraintTop_toBottomOf="@id/button18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp" />

        <!-- Bottom spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="12dp"
            app:layout_constraintTop_toBottomOf="@id/button20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
