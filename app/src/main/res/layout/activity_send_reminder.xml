<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020B38"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imageView16"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/textView48"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/abeezee"
            android:text="Send Reminder"
            android:textAlignment="textStart"
            android:textColor="#cbcafe"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/imageView16"
            app:layout_constraintBottom_toBottomOf="@id/imageView16"
            app:layout_constraintStart_toEndOf="@id/imageView16"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="12dp" />

        <!-- Send Message To (label) -->
        <TextView
            android:id="@+id/textView54"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send Message To"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/imageView16"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp" />

        <!-- Send Message To (input) -->
        <EditText
            android:id="@+id/propertyNameEdit2"
            android:layout_width="0dp"
            android:layout_height="33dp"
            android:background="#9AFFFFFF"
            android:backgroundTint="#FFFFFF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#232222"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/textView54"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- Reminder Type (label) -->
        <TextView
            android:id="@+id/textView55"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reminder Type"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/propertyNameEdit2"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp" />

        <!-- Reminder Type (input) -->
        <EditText
            android:id="@+id/propertyNameEdit5"
            android:layout_width="0dp"
            android:layout_height="33dp"
            android:background="#9AFFFFFF"
            android:backgroundTint="#FFFFFF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#232222"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/textView55"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- Message (label) -->
        <TextView
            android:id="@+id/textView56"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Message"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/propertyNameEdit5"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp" />

        <!-- Message (input) -->
        <EditText
            android:id="@+id/propertyNameEdit6"
            android:layout_width="0dp"
            android:layout_height="33dp"
            android:background="#9AFFFFFF"
            android:backgroundTint="#FFFFFF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#232222"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/textView56"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- SEND button -->
        <Button
            android:id="@+id/uploadButton5"
            android:layout_width="0dp"
            android:layout_height="43dp"
            android:backgroundTint="#A98F3C"
            android:text="SEND"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/propertyNameEdit6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <!-- Bottom spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="12dp"
            app:layout_constraintTop_toBottomOf="@id/uploadButton5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
