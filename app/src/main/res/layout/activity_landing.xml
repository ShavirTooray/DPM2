<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020B38"
    android:fillViewport="true">

    <!-- ScrollView can only have one direct child -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="20dp">

        <!-- Tagline -->
        <TextView
            android:id="@+id/rentStatusLabel2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Find your dream house with Lease Link today."
            android:textColor="#EDE5E5"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp" />

        <!-- Hero image -->
        <ImageView
            android:id="@+id/imageView14"
            android:layout_width="0dp"
            android:layout_height="179dp"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:src="@drawable/istockphoto_109350275_612x612"
            app:layout_constraintTop_toBottomOf="@id/rentStatusLabel2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp" />

        <!-- Browse CTA aligned to hero's bottom-end -->

        <!-- ===== Properties grid (2 x 2) using ImageButtons ===== -->

        <!-- Row 1, Col 1 -->
        <Button
            android:id="@+id/button8"
            android:layout_width="wrap_content"
            android:layout_height="41dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#A98F3C"
            android:text="BROWSE"
            android:textAllCaps="true"
            android:textColor="#000000"
            app:layout_constraintBottom_toBottomOf="@id/imageView14"
            app:layout_constraintEnd_toEndOf="@id/imageView14" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardProperty1"
            android:layout_width="0dp"
            android:layout_height="258dp"
            android:background="#52CBCAFE"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/imageView14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cardProperty2"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="16dp">

            <ImageButton
                android:id="@+id/imageButton7"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:adjustViewBounds="true"
                android:background="@null"
                android:padding="0dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/images"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/textView34"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/textView34"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Property 1"
                android:textColor="#cbcafe"
                android:textSize="24sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Row 1, Col 2 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardProperty2"
            android:layout_width="0dp"
            android:layout_height="258dp"
            android:background="#52CBCAFE"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/imageView14"
            app:layout_constraintStart_toEndOf="@id/cardProperty1"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp">

            <ImageButton
                android:id="@+id/imageButton8"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:adjustViewBounds="true"
                android:background="@null"
                android:padding="0dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/_60x470xc"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/textView35"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/textView35"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Property 2"
                android:textColor="#cbcafe"
                android:textSize="24sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Row 2, Col 1 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardProperty3"
            android:layout_width="0dp"
            android:layout_height="253dp"
            android:background="#52CBCAFE"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardProperty1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cardProperty4"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="12dp">

            <ImageButton
                android:id="@+id/imageButton9"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:adjustViewBounds="true"
                android:background="@null"
                android:padding="0dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/_60x470xc__1_"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/textView41"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/textView41"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Property 3"
                android:textColor="#cbcafe"
                android:textSize="24sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Row 2, Col 2 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardProperty4"
            android:layout_width="0dp"
            android:layout_height="253dp"
            android:background="#52CBCAFE"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardProperty2"
            app:layout_constraintStart_toEndOf="@id/cardProperty3"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp">

            <ImageButton
                android:id="@+id/imageButton10"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:adjustViewBounds="true"
                android:background="@null"
                android:padding="0dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/__bedroom_apartment_for_sale_ewan_residence_1_lp46040_200f39ee9fdb2600"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/textView42"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/textView42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Property 4"
                android:textColor="#cbcafe"
                android:textSize="24sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Sign up button (no bottom-to-parent constraint so it can scroll) -->
        <Button
            android:id="@+id/button6"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:backgroundTint="#A98F3C"
            android:text=" Sign up"
            android:textSize="20sp"
            android:textAllCaps="false"
            android:textColor="#000000"
            app:layout_constraintTop_toBottomOf="@id/cardProperty3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="53dp"
            android:layout_marginEnd="53dp"
            android:layout_marginTop="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>


