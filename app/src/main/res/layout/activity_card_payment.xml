<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020B38">

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="126dp"
        android:layout_height="122dp"
        android:src="@drawable/logo"
        android:contentDescription="@string/app_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp" />

    <TextView
        android:id="@+id/textView50"
        android:layout_width="245dp"
        android:layout_height="48dp"
        android:fontFamily="@font/abeezee"
        android:text="Card Payment"
        android:textAlignment="viewStart"
        android:textColor="#cbcafe"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="150dp"
        android:layout_marginTop="37dp" />

    <TextView
        android:id="@+id/textView31"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payment Details"
        android:textColor="#B1B1B1"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="18dp"
        android:layout_marginTop="179dp" />

    <EditText
        android:id="@+id/cardNumberInput"
        android:layout_width="384dp"
        android:layout_height="54dp"
        android:background="#FBFBFB"
        android:hint="Card Number"
        android:inputType="number"
        android:textColor="#B1B1B1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="18dp"
        android:layout_marginTop="258dp" />

    <EditText
        android:id="@+id/cardExpiryInput"
        android:layout_width="384dp"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:hint="Expiry Date (MM/YY)"
        android:textColor="#B1B1B1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="18dp"
        android:layout_marginTop="311dp" />

    <EditText
        android:id="@+id/cardCVVInput"
        android:layout_width="384dp"
        android:layout_height="53dp"
        android:background="#FFFFFF"
        android:hint="CVV"
        android:inputType="numberPassword"
        android:textColor="#FDF1F1"
        android:textColorHighlight="#F6EFEF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="18dp"
        android:layout_marginTop="369dp" />

    <Button
        android:id="@+id/button17"
        android:layout_width="375dp"
        android:layout_height="63dp"
        android:text="Pay Now"
        android:textColor="#000000"
        android:textSize="24sp"
        android:backgroundTint="#cbcafe"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
