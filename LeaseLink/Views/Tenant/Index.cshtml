@{
    ViewData["Title"] = "Tenant Dashboard";
}

<div class="container py-4">
    <h2 class="text-white mb-4">Tenant</h2>

    <div class="row gy-3">
        <div class="col-md-4">
            <a asp-action="Landing" class="btn btn-ll-beige w-100 py-3">Landing Screen</a>
        </div>
        <div class="col-md-4">
            <a asp-action="Maintenance" class="btn btn-ll-beige w-100 py-3">Submit Maintenance Request</a>
        </div>
        <div class="col-md-4">
            <a asp-action="Payment" class="btn btn-ll-beige w-100 py-3">Make Payment</a>
        </div>
        <div class="col-md-4">
            <a asp-action="Settings" class="btn btn-ll-beige w-100 py-3">Change Settings</a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Account" asp-action="Logout" class="btn btn-ll-outline-navy w-100 py-3">Log out</a>
        </div>
    </div>
</div>
