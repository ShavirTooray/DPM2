@model IEnumerable<LeaseLink.Models.Unit>
@{
    ViewData["Title"] = "Available Units";
}
<h2>Available Units</h2>
<form method="get" class="row g-2 mb-3">
    <div class="col"><input class="form-control" name="city" placeholder="City" /></div>
    <div class="col-auto"><button class="btn btn-primary">Filter</button></div>
</form>
<table class="table table-striped">
    <thead><tr><th>Property</th><th>Unit</th><th>Rent</th><th></th></tr></thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Property.Name (@u.Property.City)</td>
                <td>@u.Number</td>
                <td>R @u.MonthlyRent</td>
                <td><a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details","Properties",new { id=u.Id })">View</a></td>
            </tr>
        }
    </tbody>
</table>
