@model IEnumerable<LeaseLink.Models.MaintenanceRequest>
@{
    ViewData["Title"] = "Maintenance";
}
<h2>My Maintenance Requests</h2>
<p><a class="btn btn-primary" asp-action="Create">New Request</a></p>
<table class="table">
    <thead><tr><th>When</th><th>Unit</th><th>Category</th><th>Urgency</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.CreatedUtc.ToLocalTime()</td>
                <td>@m.Unit.Property.Name / @m.Unit.Number</td>
                <td>@m.Category</td>
                <td>@m.Urgency</td>
                <td>@m.Status</td>
            </tr>
        }
    </tbody>
</table>
