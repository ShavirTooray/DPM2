@model LeaseLink.Controllers.MaintenanceController.CreateVm
@{
    ViewData["Title"] = "New Maintenance Request";
    var units = (IEnumerable<dynamic>)ViewBag.Units;
}
<h2>New Maintenance Request</h2>
<form method="post" class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Unit</label>
        <select name="UnitId" class="form-select">
            @foreach (var u in units)
            {
                <option value="@u.Id">@u.Label</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Category</label>
        <select name="Category" class="form-select">
            <option>General</option>
            <option>Plumbing</option>
            <option>Electrical</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Urgency</label>
        <select name="Urgency" class="form-select">
            <option>Normal</option>
            <option>High</option>
        </select>
    </div>
    <div class="col-12">
        <label class="form-label">Description</label>
        <textarea name="Description" class="form-control"></textarea>
    </div>
    <div class="col-12"><button class="btn btn-primary">Submit</button></div>
</form>
