@model LeaseLink.Controllers.ReportRequestViewModel
@{
    ViewData["Title"] = "Admin • Reports";
}

<div class="container py-4">
    <h2 class="text-white mb-3">Generate Reports</h2>

    <form asp-action="Reports" method="post" class="row gy-3">
        @Html.AntiForgeryToken()

        <div class="col-md-3">
            <label asp-for="From" class="form-label text-white"></label>
            <input asp-for="From" class="form-control" />
            <span asp-validation-for="From" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="To" class="form-label text-white"></label>
            <input asp-for="To" class="form-control" />
            <span asp-validation-for="To" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="Type" class="form-label text-white">Report Type</label>
            <select asp-for="Type" class="form-select">
                <option>Occupancy</option>
                <option>Financials</option>
                <option>Maintenance</option>
            </select>
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-ll-beige w-100">Generate</button>
        </div>
    </form>

    @if (Model.GeneratedAt.HasValue)
    {
        <div class="card shadow-sm mt-4">
            <div class="card-body">
                <div class="text-beige small">Generated @Model.GeneratedAt.Value.ToLocalTime()</div>
                <div class="h5 mt-2 mb-0">@Model.Type Report</div>
                <p class="mb-0 mt-2">@Model.Summary</p>
            </div>
        </div>
    }

    <a asp-action="Index" class="btn btn-ll-outline-navy mt-3">Back</a>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
 }
