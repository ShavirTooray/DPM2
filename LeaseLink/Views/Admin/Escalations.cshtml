@model IEnumerable<LeaseLink.Controllers.EscalationViewModel>
@{
    ViewData["Title"] = "Admin • Escalations";
}

<div class="container py-4">
    <h2 class="text-white mb-3">Escalations</h2>

    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success">@ok</div>
    }

    <div class="table-responsive">
        <table class="table table-dark table-striped align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Severity</th>
                    <th>Created</th>
                    <th>Status</th>
                    <th style="width:220px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.Id</td>
                        <td>@e.Title</td>
                        <td>@e.Severity</td>
                        <td>@e.CreatedOn.ToLocalTime()</td>
                        <td>@e.Status</td>
                        <td>
                            <form asp-action="Resolve" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@e.Id" />
                                <button class="btn btn-success btn-sm">Resolve</button>
                            </form>
                            <form asp-action="Dismiss" method="post" class="d-inline ms-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@e.Id" />
                                <button class="btn btn-secondary btn-sm">Dismiss</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a asp-action="Index" class="btn btn-ll-outline-navy mt-2">Back</a>
</div>
