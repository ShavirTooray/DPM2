@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
    <h2 class="text-white mb-4">Admin Dashboard</h2>

    <div class="row gy-3">
        <div class="col-md-4">
            <a asp-action="Dashboard" class="btn btn-ll-beige w-100 py-3">View Dashboard</a>
        </div>
        <div class="col-md-4">
            <a asp-action="Broadcasts" class="btn btn-ll-beige w-100 py-3">Send Broadcasts</a>
        </div>
        <div class="col-md-4">
            <a asp-action="Escalations" class="btn btn-ll-beige w-100 py-3">Review Escalations</a>
        </div>
        <div class="col-md-4">
            <a asp-action="Reports" class="btn btn-ll-beige w-100 py-3">Generate Reports</a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Account" asp-action="Logout" class="btn btn-ll-outline-navy w-100 py-3">Log out</a>
        </div>
    </div>
</div>
