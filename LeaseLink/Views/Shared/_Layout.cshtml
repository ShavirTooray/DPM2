@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - LeaseLink</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="ll-dark">
    <header>
        <!-- Beige navbar (no image, no Browse link) -->
        <nav class="navbar navbar-expand-lg ll-navbar">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">
                    LeaseLink
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon" style="filter: invert(1)"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @* intentionally empty: removed Browse link *@
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Admin Dashboard</a></li>
                            }
                            if (User.IsInRole("Manager"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Manager" asp-action="Index">Manager Dashboard</a></li>
                            }
                            if (User.IsInRole("HigherManagement"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="HigherManagement" asp-action="Index">Exec Dashboard</a></li>
                            }
                            if (User.IsInRole("Tenant"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Tenant" asp-action="Index">Tenant Dashboard</a></li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (!(User.Identity?.IsAuthenticated ?? false))
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-ll-beige me-2" asp-controller="Home" asp-action="Browse">Browse as Tenant</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-ll-outline-navy" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-3 navbar-text ll-navtext">Hello, @User.Identity!.Name</li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-ll-outline-navy">Logout</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @RenderBody()
    </div>


    <footer class="ll-footer py-4 mt-auto">
        <div class="container d-flex justify-content-between">
            <span>&copy; @DateTime.UtcNow.Year LeaseLink</span>
            <span><a class="ll-footer-link" asp-controller="Home" asp-action="Index">Home</a></span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
