@model LeaseLink.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-wrap container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xxl-6">
            <div class="auth-card shadow-lg rounded-4 p-4 p-md-5">

                <!-- Brand / welcome -->
                <div class="text-center mb-4">
                    <img src="~/images/Logo.jpeg" alt="LeaseLink" class="auth-logo mb-3" />
                    <h1 class="auth-title text-white mb-1">Welcome to LeaseLink</h1>
                    <p class="text-beige mb-0">Sign in to continue</p>
                </div>

                <!-- Sign up prompt (like your mock) -->
                <div class="text-center mb-4">
                    <span class="text-white-50 me-2">New to this platform?</span>
                    <a class="btn btn-ll-beige btn-sm px-4"
                       asp-controller="Account" asp-action="Register">Sign up</a>
                </div>

                <!-- Login form -->
                <form asp-action="Login" method="post" class="mt-2">
                    @Html.AntiForgeryToken()

                    <!-- Role selector -->
                    <div class="mb-3">
                        <label class="form-label text-white" for="Role">Login as</label>
                        <select class="form-select" id="Role" name="Role">
                            <option value="Admin" selected>Admin</option>
                            <option value="Manager">Manager</option>
                            <option value="HigherManagement">Higher Management</option>
                            <option value="Tenant">Tenant</option>
                        </select>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-white"></label>
                        <input asp-for="Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label text-white"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <!-- Remember me + Forgot -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="RememberMe" />
                            <label class="form-check-label text-white-50" asp-for="RememberMe"></label>
                        </div>
                        <a class="link-light text-decoration-underline" asp-action="ForgotPassword">Forgot password?</a>
                    </div>

                    <!-- CTA -->
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-ll-beige py-2">Login</button>
                        <a class="btn btn-ll-outline-navy" asp-controller="Home" asp-action="Index">Back</a>
                    </div>

                    <!-- Demo hint -->
                    <div class="mt-3 small text-white-50">
                        Demo users: <span class="text-beige">admin@leaselink.com</span> /
                        <span class="text-beige">manager@leaselink.com</span> /
                        <span class="text-beige">exec@leaselink.com</span> /
                        <span class="text-beige">tenant@leaselink.com</span><br />
                        Demo password: <span class="text-beige">Pass123!</span>
                    </div>
                </form>

                <!-- Already registered (secondary prompt) -->
                <div class="text-center mt-4 pt-2 border-top border-opacity-25">
                    <span class="text-white-50 me-2">Already registered?</span>
                    <a class="btn btn-ll-outline-navy btn-sm px-4" asp-action="Login">Login</a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
