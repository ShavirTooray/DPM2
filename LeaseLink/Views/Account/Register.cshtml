@model LeaseLink.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-wrap container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xxl-6">
            <div class="auth-card shadow-lg rounded-4 p-4 p-md-5">
                <div class="text-center mb-4">
                    <img src="~/images/Logo.jpeg" class="auth-logo mb-3" alt="LeaseLink" />
                    <h1 class="auth-title text-white mb-1">Create New Account</h1>
                    <p class="text-beige mb-0">Join LeaseLink</p>
                </div>

                <form asp-action="Register" method="post" class="mt-3">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label text-white"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label text-white">Register as</label>
                        <select asp-for="Role" class="form-select">
                            <option>Tenant</option>
                            <option>Manager</option>
                            <option>Admin</option>
                            <option>HigherManagement</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-white"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label text-white"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label text-white"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-ll-beige py-2">Sign up</button>
                        <a class="btn btn-ll-outline-navy" asp-action="Login">Back to Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
 }
