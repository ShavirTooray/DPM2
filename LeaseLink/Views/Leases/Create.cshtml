@model IEnumerable<LeaseLink.Models.Lease>
@{
    ViewData["Title"] = "Leases";
}
<h2>Leases</h2>
<p><a class="btn btn-primary" asp-action="Create">Create Lease</a></p>
<table class="table">
    <thead><tr><th>Unit</th><th>Tenant</th><th>Start</th><th>End</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td>@l.Unit.Property.Name / @l.Unit.Number</td>
                <td>@l.Tenant.FullName</td>
                <td>@l.Start</td>
                <td>@l.End</td>
                <td>@l.Status</td>
            </tr>
        }
    </tbody>
</table>
